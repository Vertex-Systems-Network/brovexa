{
  "name": "brovexa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "node scripts/dev-api.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:foundation:test": "node scripts/verify-foundation.test.mjs",
    "quality:runtime": "pnpm run build && pnpm run typecheck && pnpm run test",
    "quality": "pnpm run verify:foundation && pnpm run verify:foundation:test && pnpm run quality:runtime"
  },
  "devDependencies": {
    "@types/node": "24.13.0",
    "turbo": "2.10.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
